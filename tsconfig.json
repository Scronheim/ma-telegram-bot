{
  "compilerOptions": {
    "incremental": true,
    "target": "es2022",
    "module": "es6",
    "moduleResolution": "bundler",
    "allowJs": true,
    "strict": true,
    "inlineSources": true,
    "allowImportingTsExtensions": true,
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["./src"],
  "exclude": ["**/node_modules"]
}
